<compatibility-matrix version="2.0" type="framework">
    <!-- Charging -->
    <hal format="aidl" optional="true">
        <name>vendor.noth.hardware.charge</name>
        <interface>
            <name>ICharge</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- Biometrics -->
    <hal format="aidl" optional="true">
        <name>vendor.goodix.hardware.biometrics.fingerprint</name>
        <interface>
            <name>IGoodixFingerprintDaemon</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- Sensors -->
    <hal format="aidl" optional="true">
        <name>vendor.noth.hardware.sensor.sensor_extension</name>
        <interface>
            <name>ISensorExtension</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- Radio IMS -->
    <hal format="aidl" optional="true">
        <name>vendor.qti.hardware.radio.ims</name>
        <version>13-16</version>
        <interface>
            <name>IImsRadio</name>
            <instance>imsradio0</instance>
            <instance>imsradio1</instance>
        </interface>
    </hal>
    <!-- Radio QtiRadioConfig -->
    <hal format="aidl" optional="true">
        <name>vendor.qti.hardware.radio.qtiradioconfig</name>
        <version>5-6</version>
        <interface>
            <name>IQtiRadioConfig</name>
            <instance>default</instance>
        </interface>
    </hal>
</compatibility-matrix>

