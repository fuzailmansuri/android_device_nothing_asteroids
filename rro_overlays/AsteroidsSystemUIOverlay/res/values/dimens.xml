<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="keyguard_indication_margin_bottom">350px</dimen>

    <!-- Location on the screen of the center of the physical power button. This is a reasonable
    default that should be overridden by device-specific overlays. -->
    <dimen name="physical_power_button_center_screen_location_y">1030px</dimen>

    <!-- The padding on the top of the statusbar (usually 0). -->
    <dimen name="status_bar_padding_top">20px</dimen>

    <!-- The padding on the start of the status bar. -->
    <dimen name="status_bar_padding_start">58px</dimen>

    <!-- Microns/ums (1000 um = 1mm) per pixel for the given device. If unspecified, UI that
         relies on this value will not be sized correctly. -->
    <item name="pixel_pitch" format="float" type="dimen">62.91</item>

    <!-- Udfps animation vertical offset -->
    <dimen name="udfps_animation_offset">-20px</dimen>

    <!-- The width/height of the keyguard bottom area icon view on keyguard. -->
    <dimen name="keyguard_affordance_fixed_height">56dp</dimen>
    <dimen name="keyguard_affordance_fixed_width">56dp</dimen>
    <dimen name="keyguard_affordance_fixed_radius">28dp</dimen>
    <dimen name="keyguard_affordance_fixed_padding">16dp</dimen>

    <!-- Amount the button should shake when it's not long-pressed for long enough. -->
    <dimen name="keyguard_affordance_shake_amplitude">4dp</dimen>

    <!-- The offset of the keyguard bottom area icon view from respective edges. -->
    <dimen name="keyguard_affordance_horizontal_offset">28dp</dimen>
    <dimen name="keyguard_affordance_vertical_offset">52dp</dimen>
</resources>
