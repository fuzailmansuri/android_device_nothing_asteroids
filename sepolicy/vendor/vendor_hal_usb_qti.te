allow vendor_hal_usb_qti sysfs_udc:dir r_dir_perms;
allow vendor_hal_usb_qti sysfs_udc:lnk_file r_file_perms;
allow vendor_hal_usb_qti sysfs_udc:file rw_file_perms;

# Allow isDisplayOff() to read /sys/class/backlight/panel0-backlight/brightness
r_dir_file(vendor_hal_usb_qti, vendor_sysfs_graphics)

