on early-init
    setprop ro.boot.product.hardware.sku ${ro.boot.hardware.sku}

    # Change ownership of sysfs power control nodes for display
    chown system graphics /sys/devices/platform/soc/ae00000.qcom,mdss_mdp/power/control
    chown system graphics /sys/devices/platform/soc/a800000.qcom,mdss_mdp/power/control
    chmod 664 /sys/devices/platform/soc/ae00000.qcom,mdss_mdp/power/control
    chmod 664 /sys/devices/platform/soc/a800000.qcom,mdss_mdp/power/control

on fs && property:ro.boot.pbid=Base
    mount overlay overlay /vendor/etc/camera lowerdir=/vendor/etc/camera:/odm/overlayfs_origin/base/etc/camera,context=u:object_r:vendor_configs_file:s0

    setprop vendor.usb.product_string "Nothing Phone (3a)"

on fs && property:ro.boot.pbid=Pro
    mount overlay overlay /vendor/etc/camera lowerdir=/vendor/etc/camera:/odm/overlayfs_origin/pro/etc/camera,context=u:object_r:vendor_configs_file:s0

    setprop vendor.usb.product_string "Nothing Phone (3a) Pro"

on late-fs && property:ro.boot.hardware.sku=JPN
    start gto_secure_element_aidl_service

service gto_secure_element_aidl_service /vendor/bin/hw/android.hardware.secure_element-service.thales
    override
    class hal
    user secure_element
    group secure_element nfc
    disabled

# Shared init services whose executables are not shipped on this target.
service ptt_socket_app /system/vendor/bin/ptt_socket_app -d
    override
    class main
    user wifi
    group wifi system inet net_admin
    capabilities NET_ADMIN
    disabled
    oneshot

service chre /vendor/bin/chre
    override
    class late_start
    user system
    group system
    socket chre seqpacket 0660 root system
    shutdown critical
    disabled

service nqnfcinfo /system/vendor/bin/nqnfcinfo
    override
    class late_start
    group nfc
    user system
    disabled
    oneshot

service qseeproxydaemon /system/vendor/bin/qseeproxydaemon
    override
    class late_start
    user system
    group system
    disabled

service qvop-daemon /vendor/bin/qvop-daemon
    override
    class late_start
    user system
    group system drmrpc
    disabled

service esepmdaemon /system/vendor/bin/esepmdaemon
    override
    class core
    user system
    group nfc
    disabled

# Sensors
on property:vendor.all.modules.ready=1
    chown system system /proc/touchpanel/gesture_code
    chmod 0660 /proc/touchpanel/gesture_code
    chown system system /proc/touchpanel/gesture_mode
    chmod 0660 /proc/touchpanel/gesture_mode
    chown system system /sys/devices/platform/soc/ac0000.qcom,qupv3_0_geni_se/a80000.spi/spi_master/spi0/spi0.0/fts_fod_enabled
    chown system system /sys/devices/platform/soc/ac0000.qcom,qupv3_0_geni_se/a80000.spi/spi_master/spi0/spi0.0/fts_fod_pressed
    chown system system /sys/devices/platform/soc/ac0000.qcom,qupv3_0_geni_se/a80000.spi/spi_master/spi0/spi0.0/fts_gesture_mode
    chmod 0660 /sys/devices/platform/soc/ac0000.qcom,qupv3_0_geni_se/a80000.spi/spi_master/spi0/spi0.0/fts_gesture_mode
    chown system system /sys/devices/platform/soc/ac0000.qcom,qupv3_0_geni_se/a80000.spi/spi_master/spi0/spi0.0/fts_gesture_single_tap_enabled
    chmod 0660 /sys/devices/platform/soc/ac0000.qcom,qupv3_0_geni_se/a80000.spi/spi_master/spi0/spi0.0/fts_gesture_single_tap_enabled
    chown system system /sys/devices/platform/soc/ac0000.qcom,qupv3_0_geni_se/a80000.spi/spi_master/spi0/spi0.0/fts_gesture_single_tap_pressed
    chmod 0660 /sys/devices/platform/soc/ac0000.qcom,qupv3_0_geni_se/a80000.spi/spi_master/spi0/spi0.0/fts_gesture_single_tap_pressed
