<displayConfiguration>
    <screenBrightnessMap interpolation="linear">
        <point>
            <value>0.0</value>
            <nits>2.0</nits>
        </point>
        <point>
            <value>0.032723</value>
            <nits>3.0</nits>
        </point>
        <point>
            <value>0.081074</value>
            <nits>6.0</nits>
        </point>
        <point>
            <value>0.110379</value>
            <nits>10.0</nits>
        </point>
        <point>
            <value>0.160928</value>
            <nits>20.0</nits>
        </point>
        <point>
            <value>0.246642</value>
            <nits>50.0</nits>
        </point>
        <point>
            <value>0.345055</value>
            <nits>100.0</nits>
        </point>
        <point>
            <value>0.478877</value>
            <nits>200.0</nits>
        </point>
        <point>
            <value>0.571429</value>
            <nits>300.0</nits>
        </point>
        <point>
            <value>0.649328</value>
            <nits>400.0</nits>
        </point>
        <point>
            <value>0.719414</value>
            <nits>500.0</nits>
        </point>
        <point>
            <value>0.840537</value>
            <nits>800.0</nits>
        </point>
        <point>
            <value>1.0</value>
            <nits>1300.0</nits>
        </point>
    </screenBrightnessMap>

    <highBrightnessMode enabled="true">
        <transitionPoint>0.840537</transitionPoint>
        <minimumLux>7500.0</minimumLux>
        <timing>
            <!-- allow for 5 minutes out of every 30 minutes -->
            <timeWindowSecs>1800</timeWindowSecs>
            <timeMaxSecs>300</timeMaxSecs>
            <timeMinSecs>60</timeMinSecs>
        </timing>
        <minimumHdrPercentOfScreen>0.2</minimumHdrPercentOfScreen>
        <!--sdrHdrRatioMap, backed by spline, must have at least two entries -->
        <sdrHdrRatioMap>
            <point>
                <sdrNits>2.0</sdrNits>
                <hdrRatio>7.8</hdrRatio>
            </point>
            <point>
                <sdrNits>10.0</sdrNits>
                <hdrRatio>7.8</hdrRatio>
            </point>
            <point>
                <sdrNits>50.0</sdrNits>
                <hdrRatio>6.8</hdrRatio>
            </point>
            <point>
                <sdrNits>100.0</sdrNits>
                <hdrRatio>5.8</hdrRatio>
            </point>
            <point>
                <sdrNits>200.0</sdrNits>
                <hdrRatio>4.85</hdrRatio>
            </point>
            <point>
                <sdrNits>300.0</sdrNits>
                <hdrRatio>4.4</hdrRatio>
            </point>
            <point>
                <sdrNits>400.0</sdrNits>
                <hdrRatio>4.15</hdrRatio>
            </point>
            <point>
                <sdrNits>500.0</sdrNits>
                <hdrRatio>3.9</hdrRatio>
            </point>
            <point>
                <sdrNits>800.0</sdrNits>
                <hdrRatio>3.65</hdrRatio>
            </point>
            <point>
                <sdrNits>1300.0</sdrNits>
                <hdrRatio>2.246</hdrRatio>
            </point>
        </sdrHdrRatioMap>
    </highBrightnessMode>

    <thermalThrottling>
        <throttlingMap>
            <map>
                <thermalStatus>light</thermalStatus>
                <brightness>0.92000</brightness>
            </map>
            <map>
                <thermalStatus>moderate</thermalStatus>
                <brightness>0.840537</brightness>
            </map>
            <map>
                <thermalStatus>severe</thermalStatus>
                <brightness>0.719414</brightness>
            </map>
            <map>
                <thermalStatus>critical</thermalStatus>
                <brightness>0.571429</brightness>
            </map>
            <map>
                <thermalStatus>emergency</thermalStatus>
                <brightness>0.345055</brightness>
            </map>
        </throttlingMap>
    </thermalThrottling>

    <screenBrightnessRampFastDecrease>0.06</screenBrightnessRampFastDecrease>
    <screenBrightnessRampFastIncrease>0.04</screenBrightnessRampFastIncrease>
    <screenBrightnessRampSlowDecrease>0.04</screenBrightnessRampSlowDecrease>
    <screenBrightnessRampSlowIncrease>0.02</screenBrightnessRampSlowIncrease>
    <screenBrightnessRampIncreaseMaxMillis>4000</screenBrightnessRampIncreaseMaxMillis>
    <screenBrightnessRampDecreaseMaxMillis>3000</screenBrightnessRampDecreaseMaxMillis>
</displayConfiguration>
