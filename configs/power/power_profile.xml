    Power Profile for Nothing Phone (3a) - Snapdragon 7s Gen 3
    
    This power profile provides battery consumption estimates for various
    device components and states. Values are in mAh and represent current draw.
    
    NOTE: These values are estimates based on Snapdragon 7s Gen 3 specifications
    and should be calibrated with actual device measurements for accuracy.
-->
<device name="Android">
    <!-- Display power -->
    <item name="screen.on">85</item>
    <item name="screen.full">380</item>
    
    <!-- Ambient display power (AOD) -->
    <item name="ambient.on">15</item>
    
    <!-- CPU power consumption -->
    <!-- Cortex-A55 cluster (4 cores @ 1.8 GHz) -->
    <array name="cpu.clusters.cores">
        <value>4</value> <!-- Little cluster -->
        <value>4</value> <!-- Big cluster -->
    </array>
    
    <!-- CPU speeds for little cluster (Cortex-A55) in KHz -->
    <array name="cpu.core_speeds.cluster0">
        <value>300000</value>
        <value>614400</value>
        <value>806400</value>
        <value>1017600</value>
        <value>1228800</value>
        <value>1516800</value>
        <value>1804800</value>
    </array>
    
    <!-- CPU speeds for big cluster (Cortex-A76) in KHz -->
    <array name="cpu.core_speeds.cluster1">
        <value>710400</value>
        <value>940800</value>
        <value>1171200</value>
        <value>1401600</value>
        <value>1632000</value>
        <value>1862400</value>
        <value>2092800</value>
        <value>2323200</value>
        <value>2553600</value>
    </array>
    
    <!-- Power consumption for little cluster at different speeds (mA) -->
    <array name="cpu.core_power.cluster0">
        <value>8</value>   <!-- 300 MHz -->
        <value>12</value>  <!-- 614 MHz -->
        <value>18</value>  <!-- 806 MHz -->
        <value>24</value>  <!-- 1017 MHz -->
        <value>32</value>  <!-- 1228 MHz -->
        <value>45</value>  <!-- 1516 MHz -->
        <value>60</value>  <!-- 1804 MHz -->
    </array>
    
    <!-- Power consumption for big cluster at different speeds (mA) -->
    <array name="cpu.core_power.cluster1">
        <value>35</value>  <!-- 710 MHz -->
        <value>50</value>  <!-- 940 MHz -->
        <value>68</value>  <!-- 1171 MHz -->
        <value>90</value>  <!-- 1401 MHz -->
        <value>115</value> <!-- 1632 MHz -->
        <value>145</value> <!-- 1862 MHz -->
        <value>180</value> <!-- 2092 MHz -->
        <value>225</value> <!-- 2323 MHz -->
        <value>280</value> <!-- 2553 MHz -->
    </array>
    
    <!-- Additional CPU power consumption (overhead) -->
    <item name="cpu.active">15</item>
    <item name="cpu.idle">4.5</item>
    <item name="cpu.suspend">3</item>
    
    <!-- Memory subsystem -->
    <item name="memory.bandwidths">
        <value>22.7</value> <!-- bucket 0 -->
    </item>
    
    <!-- WiFi power consumption -->
    <item name="wifi.on">2</item>
    <item name="wifi.active">180</item>
    <item name="wifi.scan">80</item>
    
    <!-- Bluetooth power consumption -->
    <item name="bluetooth.active">30</item>
    <item name="bluetooth.on">1.5</item>
    <item name="bluetooth.at">35000</item>
    
    <!-- Camera power consumption -->
    <item name="camera.flashlight">250</item>
    <item name="camera.avg">600</item>
    
    <!-- GPS power consumption -->
    <item name="gps.on">60</item>
    
    <!-- Radio/Modem power consumption -->
    <item name="radio.active">200</item>
    <item name="radio.scanning">5</item>
    
    <!-- Radio power for different signal strengths -->
    <array name="radio.on">
        <value>4</value> <!-- No signal -->
        <value>3</value> <!-- Poor -->
        <value>2.5</value> <!-- Good -->
        <value>2</value> <!-- Great -->
        <value>1.5</value> <!-- Excellent -->
    </array>
    
    <!-- Audio power consumption -->
    <item name="audio">35</item>
    
    <!-- Video decoding/encoding power consumption -->
    <item name="video">45</item>
    
    <!-- Modem power consumption for data transfer -->
    <array name="modem.controller.sleep">
        <value>0</value>
    </array>
    
    <array name="modem.controller.idle">
        <value>3</value>
    </array>
    
    <array name="modem.controller.rx">
        <value>120</value>
    </array>
    
    <!-- Modem TX power levels (mA) -->
    <array name="modem.controller.tx">
        <value>90</value>   <!-- TX Power Level 0 -->
        <value>120</value>  <!-- TX Power Level 1 -->
        <value>150</value>  <!-- TX Power Level 2 -->
        <value>180</value>  <!-- TX Power Level 3 -->
        <value>220</value>  <!-- TX Power Level 4 -->
    </array>
    
    <item name="modem.controller.voltage">3700</item>
    
    <!-- WiFi controller power consumption -->
    <array name="wifi.controller.idle">
        <value>1</value>
    </array>
    
    <array name="wifi.controller.rx">
        <value>120</value>
    </array>
    
    <array name="wifi.controller.tx">
        <value>200</value>
    </array>
    
    <array name="wifi.controller.tx_levels">
        <value>1</value>
    </array>
    
    <array name="wifi.controller.operating_voltage">
        <value>3700</value>
    </array>
    
    <!-- Battery capacity -->
    <item name="battery.capacity">5000</item>
    
    <!-- Idle power drain -->
    <array name="cpu.awake">
        <value>15</value>
    </array>
</device>
