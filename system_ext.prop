# Bluetooth
bluetooth.core.le.max_number_of_concurrent_connections=10
bluetooth.device.class_of_device=90,2,12
bluetooth.leaudio.dual_bidirection_swb.supported=true
bluetooth.profile.pbap.sim.enabled=true
bluetooth.profile.pan.nap.enabled=true
bluetooth.profile.pan.panu.enabled=true
bluetooth.profile.sap.server.enabled=true
persist.bluetooth.leaudio.allow.multiple.contexts=false
persist.bluetooth.leaudio.notify.idle.during.call=true
persist.bluetooth.leaudio_offload.disabled=false
ro.bluetooth.leaudio_offload.supported=true

# Camera
vendor.camera.aux.packagelist=com.nothing.camera,org.lineageos.aperture,org.lineageos.aperture.dev

# Charger
ro.charger.enable_suspend=1

# Display
sys.brightness.disable_gamma_conversion=true

# Media
media.stagefright.thumbnail.prefer_hw_codecs=true
ro.media.recorder-max-base-layer-fps=60

# Nothing features
ro.build.nothing.feature.base=0x1004458438124a040126b4247b97ffL
ro.build.nothing.feature.diff.device.Asteroids=0xa80c901acc038d140ad44002d8842080L
ro.build.nothing.feature.diff.plus.Asteroids=0x4000000000000000000000L
ro.build.nothing.feature.diff.product.AsteroidsEEA=0x8000000000000000000000L
ro.build.nothing.feature.diff.product.AsteroidsIND=0x10000000000000000000000L
ro.build.nothing.feature.diff.product.AsteroidsJPN=0x100000120000000000000000000000L
ro.build.nothing.feature.diff.product.AsteroidsPro=0x100000000000000000000000L
ro.build.nothing.feature.diff.product.AsteroidsProEEA=0x108000000000000000000000L
ro.build.nothing.feature.diff.product.AsteroidsProIND=0x10000000000000000000000L
ro.build.nothing.feature.diff.product.AsteroidsProTUR=0x20100000000000000000000000L
ro.build.nothing.feature.diff.product.AsteroidsTUR=0x20000000000000000000000000L

# Thermal
persist.sys.sltntc.enable=1
